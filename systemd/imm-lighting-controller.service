[Unit]
Description=IMM-OS ECLSS Lighting Controller (MQTT listener)
After=network-online.target
Wants=network-online.target

# Never give up restarting (the node reports restarts: sysmon svc_restarts → MCC alarm)
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/imm-os-edge
# Shared node config + secrets (see edge.env.example); optional
EnvironmentFile=-/etc/imm-os/edge.env
ExecStart=/usr/bin/python3 eclss/lighting_controller.py --listen
Restart=always
RestartSec=5
# Watchdog (core/watchdog.py): the main loop must check in every 60 s or systemd kills
# the service and restarts it. NotifyAccess=all: in a pipeline the driver is not the main
# process. The fault handler prints the stack where it hung into the journal.
WatchdogSec=60
NotifyAccess=all
Environment="PYTHONFAULTHANDLER=1"
StandardError=journal

[Install]
WantedBy=multi-user.target
