[Unit]
Description=IMM-OS Sensor Pipeline (%i)
After=network.target

# Never give up restarting (the node reports restarts: sysmon svc_restarts → MCC alarm)
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/imm-os-edge
# Shared node config + secrets (see edge.env.example); optional
EnvironmentFile=-/etc/imm-os/edge.env
Environment="IMM_SECRET_KEY=default-dev-secret"
Environment="IMM_BLACKBOX_DIR=/var/lib/imm-os/blackbox"

# %i is the sensor driver script name (e.g. 'bme280_driver.py').
# --mode both: publish each reading to the MCC broker AND pipe it into the local
# encrypted blackbox (kept for 48 h, replayable after a network outage).
ExecStart=/bin/sh -c 'python3 sensor_drivers/%i --mode both | python3 core/encryption_layer.py | python3 core/blackbox_logger.py'

Restart=always
RestartSec=5
# Watchdog (core/watchdog.py): the main loop must check in every 120 s or systemd kills
# the service and restarts it. NotifyAccess=all: in a pipeline the driver is not the main
# process. The fault handler prints the stack where it hung into the journal.
WatchdogSec=120
NotifyAccess=all
Environment="PYTHONFAULTHANDLER=1"
StandardError=journal

[Install]
WantedBy=multi-user.target
