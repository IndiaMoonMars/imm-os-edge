# IMM-OS edge node configuration — copy to /etc/imm-os/edge.env (chmod 600).
# Read by the imm-* systemd units and by eclss/ and eva/ scripts.

# Identity of this node, stamped on every reading (shown on the Overview page).
# IMM_ZONE replaces the zone in each driver's MQTT topic (habitat/sensors/<sensor>/<zone>).
IMM_NODE_ID=node-rpi-01
IMM_ZONE=zone_a

# O2 cell calibration: millivolts in fresh air (20.9 % O2).
# Get it with: python3 sensor_drivers/o2_driver.py --calibrate
O2_CAL_MV=

# Keycloak client-credentials for this edge node (role: edge_device).
# Secret: Keycloak admin console → realm IndiaMoonMars → Clients → imm-edge → Credentials
# (or the IMM_EDGE_CLIENT_SECRET value in imm-os-infra/.env).
# Use the same public host the backend expects in the token issuer (imm.local).
KEYCLOAK_TOKEN_URL=http://imm.local/auth/realms/IndiaMoonMars/protocol/openid-connect/token
IMM_EDGE_CLIENT_ID=imm-edge
IMM_EDGE_CLIENT_SECRET=

# IMM-OS APIs on the MCC / dev server
ECLSS_API_URL=http://imm.local/eclss
EVA_API_URL=http://imm.local/eva

# Habitat MQTT broker (TLS). The broker rejects anonymous clients; edge nodes
# use the imm-edge MQTT user (topics in imm-os-infra mosquitto/config/acl).
#   MQTT_HOST     must be a name/IP in the broker certificate (gen-certs.sh)
#   MQTT_PASSWORD = MQTT_EDGE_PASSWORD in imm-os-infra/.env
#   MQTT_TLS_CA   = copy of imm-os-infra/mosquitto/certs/ca.crt
MQTT_HOST=imm.local
MQTT_PORT=8883
MQTT_USERNAME=imm-edge
MQTT_PASSWORD=
MQTT_TLS_CA=/etc/imm-os/mqtt-ca.crt

# Sensor pipelines on this node (sensor_drivers/*.py), started by deploy_services.sh
IMM_SENSORS=
# Per-sensor corrections (tools/calibrate.py)
IMM_CALIBRATION_FILE=/etc/imm-os/calibration.yaml

# ── ECLSS / EVA daemons on this node (started by deploy_services.sh) ──
# Only list what is physically fitted here. Each runs as imm-eclss@<name> / imm-eva@<name>.
IMM_ECLSS_DAEMONS=
IMM_EVA_DAEMONS=
# Set true to run every ECLSS/EVA script with synthetic data (no hardware)
IMM_SIMULATE=false

# Water flow (YF-S201): signal via a 5 V → 3.3 V divider
FLOW_GPIO=17
FLOW_PULSES_PER_L=450
FLOW_SOURCE=drinking_line
# Shower PIR (HC-SR501)
PIR_GPIO=27
SHOWER_LPM=9.0
# Waste scale (HX711) — HX711_SCALE from: python3 eclss/waste_tracker.py --calibrate 1.0
HX711_DOUT=5
HX711_SCK=6
HX711_SCALE=
# Waste-type RFID: USB reader path, or WASTE_RFID_BACKEND=rc522
WASTE_RFID_DEVICE=
# Biolab: Atlas EZO-pH (I2C) + DS18B20 on GPIO4 (dtoverlay=w1-gpio)
EZO_PH_ADDRESS=0x63
# Climate relays (de-energised = OFF = safe). Setpoints ± band.
HVAC_RELAY_GPIO=23
DEHUM_RELAY_GPIO=24
RELAY_ACTIVE_LOW=true
TEMP_SETPOINT_C=22
HUM_SETPOINT_PCT=50
# Tunable-white LED zones on the PCA9685: zone:warm_channel,cool_channel;...
LIGHT_ZONES="core:0,1;galley:2,3;sleep:4,5"
LIGHT_PCA_ADDRESS=0x40

# ── EVA suit kit ──
# Crew member wearing this kit = their IMM-OS username
CREW_ID=ev1
GPS_PORT=/dev/serial0
GPS_BAUD=38400
UWB_PORT=/dev/ttyACM0
# Airlock tool station: CSV rfid_tag,tool_name,category ; reader path or TOOL_RFID_BACKEND=rc522
TOOLS_FILE=/etc/imm-os/tools.csv
TOOL_RFID_DEVICE=
TOOL_STATION_MODE=toggle
