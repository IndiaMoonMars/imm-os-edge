[Unit]
Description=IMM-OS EVA daemon (%i)
After=network-online.target
Wants=network-online.target

# Never give up restarting (the node reports restarts: sysmon svc_restarts → MCC alarm)
StartLimitIntervalSec=0

[Service]
Type=simple
# The user needs the gpio, i2c, spi, dialout and input groups (see real-sensors/README.md)
User=ubuntu
WorkingDirectory=/home/ubuntu/imm-os-edge
# Node config + secrets (see edge.env.example)
EnvironmentFile=-/etc/imm-os/edge.env
Environment="IMM_SPOOL_DIR=/var/lib/imm-os/spool"
StateDirectory=imm-os
# %i is the script name without .py, e.g. water_monitor
ExecStart=/usr/bin/python3 eva/%i.py
Restart=always
RestartSec=5
# Watchdog (core/watchdog.py): the main loop must check in every 60 s or systemd kills
# the service and restarts it. NotifyAccess=all: in a pipeline the driver is not the main
# process. The fault handler prints the stack where it hung into the journal.
WatchdogSec=60
NotifyAccess=all
Environment="PYTHONFAULTHANDLER=1"
StandardError=journal

[Install]
WantedBy=multi-user.target
